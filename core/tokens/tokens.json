{
  "$name": "Plasma Pixel",
  "$version": "1.0.0",
  "color": {
    "void": "#05000E",
    "panel": "#0B0018",
    "border": "#2A1F44",
    "borderSoft": "#3A2C5E",
    "cyan": "#7FF9FF",
    "magenta": "#FF2D6F",
    "yellow": "#FFE600",
    "violet": "#A56BFF",
    "green": "#37F5A0",
    "orange": "#FF8A00",
    "textPrimary": "#E7E2F5",
    "textSecondary": "#8E86A8",
    "textTertiary": "#5E5580",
    "ultraAction": "#FF7A1A"
  },
  "colorLightMenuBar": [
    "#C4004F",
    "#A34A00",
    "#7A6A00",
    "#0A7A4E",
    "#0090A8",
    "#5B2BC4"
  ],
  "gradient": {
    "stops": [
      [
        "0%",
        "#FF2D6F"
      ],
      [
        "17%",
        "#FF8A00"
      ],
      [
        "34%",
        "#FFE600"
      ],
      [
        "50%",
        "#37F5A0"
      ],
      [
        "67%",
        "#7FF9FF"
      ],
      [
        "84%",
        "#A56BFF"
      ],
      [
        "100%",
        "#FF2D6F"
      ]
    ],
    "css": "linear-gradient(180deg,#FF2D6F 0%,#FF8A00 17%,#FFE600 34%,#37F5A0 50%,#7FF9FF 67%,#A56BFF 84%,#FF2D6F 100%)",
    "note": "First and last stop identical so the tile repeats seamlessly. Do not change percentages."
  },
  "type": {
    "display": {
      "family": "Silkscreen",
      "weights": [
        400,
        700
      ],
      "floorMac": 8,
      "floorWatch": 8.5
    },
    "prose": {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        600
      ],
      "floor": 10
    },
    "sizes": [
      7,
      7.5,
      8,
      8.5,
      9,
      9.5,
      10,
      10.5,
      11,
      20,
      22,
      26,
      28,
      30,
      34,
      36,
      46,
      52
    ]
  },
  "shape": {
    "radius": 0,
    "radiusExceptions": {
      "popover": 12,
      "watchHardware": "bezel 68 / screen 54 (mockup)"
    },
    "hardShadow": {
      "offset": [
        3,
        4
      ],
      "blur": 0,
      "rule": "solid color, magenta on cyan or magenta on white"
    },
    "borderChrome": "1px #2A1F44",
    "borderHierarchy": "2px color or 2px drifting gradient"
  },
  "spacing": [
    4,
    6,
    7,
    8,
    9,
    10,
    11,
    12,
    14,
    16,
    18,
    20,
    22,
    24,
    26
  ],
  "motion": {
    "speedPxPerSecond": 10,
    "tileRatio": 1.6,
    "minDurationSeconds": 3,
    "ghostCycleSeconds": 2.1,
    "ghostPhaseOffsetSeconds": -1.05,
    "ghostOpacity": 0.75,
    "skewDegrees": -2.5,
    "skewCycleSeconds": 3.4,
    "frameTile": 58,
    "frameDurationSeconds": 5.8,
    "tilesInUse": [
      30,
      32,
      36,
      42,
      45,
      48,
      58,
      72
    ]
  },
  "texture": {
    "dither": "repeating-conic-gradient(rgba(0,0,0,.60) 0% 25%, transparent 0% 50%) / 4px 4px",
    "plasma": "3 radials (cyan/magenta/violet), inset -25%, blur(7px), 9s ease-in-out drift"
  },
  "ruleColors": {
    "wholeDollar": "#7FF9FF",
    "lowBalance": "#FFE600",
    "spike": "#FF2D6F",
    "dailySummary": "#A56BFF"
  },
  "$scope": "platform-agnostic core",
  "density": {
    "note": "One identity, three densities. Tile ratio and speed never change; what changes is how much of a surface qualifies for the Mix.",
    "micro": {
      "surfaces": [
        "menu bar",
        "complication",
        "widget"
      ],
      "proseSize": [
        10,
        11
      ],
      "displaySize": [
        7,
        22
      ],
      "mixedElementsPerScreen": [
        1,
        2
      ]
    },
    "compact": {
      "surfaces": [
        "popover",
        "phone screen",
        "notification"
      ],
      "proseSize": [
        10,
        13
      ],
      "displaySize": [
        8,
        46
      ],
      "mixedElementsPerScreen": [
        2,
        4
      ]
    },
    "open": {
      "surfaces": [
        "web page",
        "dashboard",
        "slide",
        "poster"
      ],
      "proseSize": [
        15,
        19
      ],
      "displaySize": [
        11,
        220
      ],
      "mixedElementsPerScreen": [
        1,
        3
      ],
      "warning": "Prose grows but the Mix does not follow it. On a large surface most text is prose, so proportionally far less qualifies. Resist adding mixed elements to fill space."
    }
  },
  "applicability": {
    "yes": [
      "data numbers",
      "wordmarks and marks",
      "2px borders and frames",
      "one hero per screen (skew)"
    ],
    "no": [
      "button fills",
      "prose of any length",
      "form labels and help text",
      "large background areas",
      "more than one skewed element per screen"
    ]
  }
}