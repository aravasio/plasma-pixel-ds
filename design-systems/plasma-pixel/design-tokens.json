{
  "schemaVersion": "od-design-system-project/v1",
  "name": "Plasma Pixel",
  "version": "1.0.0",
  "tokenSets": {
    "shared": {
      "--bg": "#05000E",
      "--surface": "#0B0018",
      "--surface-warm": "var(--surface)",
      "--fg": "#E7E2F5",
      "--fg-2": "var(--fg)",
      "--muted": "#8E86A8",
      "--meta": "#5E5580",
      "--border": "#2A1F44",
      "--border-soft": "#3A2C5E",
      "--accent": "#7FF9FF",
      "--accent-on": "#05000E",
      "--accent-hover": "color-mix(in oklab, #7FF9FF, black 8%)",
      "--accent-active": "color-mix(in oklab, #7FF9FF, black 14%)",
      "--success": "#37F5A0",
      "--warn": "#FFE600",
      "--danger": "#FF2D6F",
      "--font-display": "\"Silkscreen\", monospace",
      "--font-body": "\"IBM Plex Mono\", ui-monospace, monospace",
      "--font-mono": "\"IBM Plex Mono\", ui-monospace, monospace",
      "--text-xs": "11px",
      "--text-sm": "12px",
      "--text-base": "15px",
      "--text-lg": "20px",
      "--text-xl": "26px",
      "--text-2xl": "34px",
      "--text-3xl": "46px",
      "--text-4xl": "64px",
      "--leading-body": "1.6",
      "--leading-tight": "1",
      "--tracking-display": "0.06em",
      "--space-1": "4px",
      "--space-2": "8px",
      "--space-3": "12px",
      "--space-4": "16px",
      "--space-5": "20px",
      "--space-6": "24px",
      "--space-8": "32px",
      "--space-12": "48px",
      "--section-y-desktop": "96px",
      "--section-y-tablet": "64px",
      "--section-y-phone": "48px",
      "--radius-sm": "0",
      "--radius-md": "0",
      "--radius-lg": "0",
      "--radius-pill": "0",
      "--elev-flat": "none",
      "--elev-ring": "0 0 0 1px var(--border)",
      "--elev-raised": "4px 4px 0 var(--pp-magenta)",
      "--focus-ring": "0 0 0 2px var(--accent)",
      "--motion-fast": "120ms",
      "--motion-base": "280ms",
      "--ease-standard": "linear",
      "--container-max": "1200px",
      "--container-gutter-desktop": "64px",
      "--container-gutter-tablet": "48px",
      "--container-gutter-phone": "24px"
    },
    "extensions": {
      "--pp-magenta": "#FF2D6F",
      "--pp-violet": "#A56BFF",
      "--pp-ultra-action": "#FF7A1A",
      "--pp-gradient": "linear-gradient(180deg,#FF2D6F 0%,#FF8A00 17%,#FFE600 34%,#37F5A0 50%,#7FF9FF 67%,#A56BFF 84%,#FF2D6F 100%)",
      "--pp-dither": "repeating-conic-gradient(rgba(0,0,0,.60) 0% 25%, transparent 0% 50%)",
      "--pp-dither-size": "4px 4px",
      "--pp-plasma": "radial-gradient(ellipse at 25% -25%, color-mix(in oklab, var(--accent) 35%, transparent), transparent 60%), radial-gradient(ellipse at 75% -25%, color-mix(in oklab, var(--pp-magenta) 35%, transparent), transparent 60%), radial-gradient(ellipse at 50% 125%, color-mix(in oklab, var(--pp-violet) 30%, transparent), transparent 60%)",
      "--pp-speed": "10",
      "--pp-tile-ratio": "1.6",
      "--pp-min-duration": "3s",
      "--pp-ghost-cycle": "2.1s",
      "--pp-ghost-phase": "-1.05s",
      "--pp-ghost-opacity": "0.75",
      "--pp-skew": "-2.5deg",
      "--pp-skew-cycle": "3.4s",
      "--pp-frame-tile": "58px",
      "--pp-frame-duration": "5.8s",
      "--pp-live-dot": "1.4s"
    }
  }
}
